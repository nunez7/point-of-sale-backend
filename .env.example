# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/punto-venta?schema=public"

# JWT
JWT_SECRET="cambiar-a-un-secret-de-al-menos-32-caracteres"
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN="*"

# Socket
SOCKET_CORS_ORIGIN="*"

# Connection pool (driver adapter @prisma/adapter-pg / pg.Pool)
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000