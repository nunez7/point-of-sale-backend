# Server
NODE_ENV=development
PORT=3001

# Interfaz de escucha (opcional). Omitido = todas las interfaces.
# HOST=127.0.0.1

# Saltos de proxy de confianza para resolver req.ip (0 = sin proxy)
TRUST_PROXY=0

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/punto-venta?schema=public"

# JWT
JWT_SECRET="WR4tUcZmliwea3IJhpYsPO6ydacoIsEXmfxjVnm35mm"
JWT_EXPIRES_IN=8h

# Restricción por IP (obligatoria en producción, admite comodín '192.168.1.*')
# - Solo este equipo:        127.0.0.1,::1
# - Varias cajas de la LAN:  127.0.0.1,::1,192.168.1.*
# - Hosting serverless (Vercel, Render, etc.): IP_ALLOWLIST_ENABLED=false y ALLOWED_IPS vacío
ALLOWED_IPS=127.0.0.1,::1

# Interruptor de la restricción por IP (true = activa, false = desactivada).
# En Vercel/serverless la IP de origen cambia en cada petición: poner false.
IP_ALLOWLIST_ENABLED=true

# CORS
# - Local:                  http://localhost:3000,http://127.0.0.1:3000
# - Frontend servido por IP: http://192.168.1.50:3000
# - Producción (origen exacto, sin barra final; no admite '*'):
#   https://point-of-sale-frontend-mauve.vercel.app
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Socket (debe coincidir con los orígenes del frontend)
SOCKET_CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Connection pool (driver adapter @prisma/adapter-pg / pg.Pool)
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
