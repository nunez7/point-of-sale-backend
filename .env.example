# ============================================================================
# Variables de la API (las mismas en local y en el hosting)
# ============================================================================

NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/punto-venta?schema=public"

# JWT
JWT_SECRET="WR4tUcZmliwea3IJhpYsPO6ydacoIsEXmfxjVnm35mm"
JWT_EXPIRES_IN=8h

# CORS — única variable de orígenes. La usan HTTP y Socket.io.
# - Local:                  http://localhost:3000,http://127.0.0.1:3000
# - Frontend servido por IP: http://192.168.1.50:3000
# - Producción (origen exacto, sin barra final; no admite '*'):
#   https://point-of-sale-frontend-mauve.vercel.app
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Connection pool (driver adapter @prisma/adapter-pg / pg.Pool)
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# Zona horaria para reportes y auto-cierre de cajas
TIMEZONE=America/Mazatlan

# ============================================================================
# Solo local (`npm run dev` / `npm start`) — NO definir en Vercel ni en ningún
# hosting serverless: la plataforma entrega el request a la función, no hay
# puerto que abrir, y el valor se ignora. Además `src/config/env.ts` no los
# valida, así que un PORT heredado no puede tumbar el arranque en producción.
# ============================================================================

# Puerto del listener HTTP local (por defecto 3001; el frontend espera 3001).
# PORT=3001

# Interfaz de escucha (opcional). Omitido = todas las interfaces.
# HOST=127.0.0.1
