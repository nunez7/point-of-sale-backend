generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GERENTE
  VENDEDOR
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
  OTHER
}

enum StoreRelation {
  OWNED
  ASSIGNED
}

// Forma de venta del producto:
// - UNIDAD: se vende por bulto/pieza (cantidad entera).
// - PESO: se vende a granel por peso; costPrice/sellingPrice son por kilogramo.
// - VOLUMEN: se vende a granel por volumen; costPrice/sellingPrice son por litro.
enum UnidadVenta {
  UNIDAD
  PESO
  VOLUMEN
}

enum CancellationReason {
  ERROR_FACTURACION
  CLIENTE_PROVEEDOR_SOLICITA
  DUPLICADA
  DEVOLUCION_MERCANCIA
  CANCELACION_PEDIDO
  OTRO
}

model Store {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  representante String?
  phone     String?
  rfc           String?
  regimenFiscal String?
  codigoPostal  String?
  saleSequence Int    @default(0)
  facturaSequence Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]            @relation("UserStore")
  inventories    Inventory[]
  sales          Sale[]
  supplierTx     SupplierTransaction[]
  products       Product[]
  auditLogs      AuditLog[]
  categories     Category[]
  suppliers      Supplier[]
  clientes       Cliente[]
  facturas       Factura[]
  cancellations  Cancellation[]
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  role         Role           @default(VENDEDOR)
  storeId      String
  store        Store          @relation("UserStore", fields: [storeId], references: [id], onDelete: Cascade)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sales            Sale[]
  supplierTx       SupplierTransaction[]
  auditLogs        AuditLog[]
  revokedTokens    RevokedToken[]
  facturas         Factura[]
  cancellations    Cancellation[]
}

model RevokedToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  products Product[]
  @@unique([name, storeId])
}

model Product {
  id           String     @id @default(cuid())
  name         String
  sku          String?    @unique
  description  String?
  presentacion String?
  unidadVenta  UnidadVenta @default(UNIDAD)
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  costPrice    Decimal    @db.Decimal(12, 2)
  sellingPrice Decimal    @db.Decimal(12, 2)
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inventories          Inventory[]
  saleItems            SaleItem[]
  supplierTxItems      SupplierTransactionItem[]

  @@index([storeId])
}

model Inventory {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Decimal para soportar productos a granel (ej. 25.5 kg de arroz).
  quantity  Decimal @db.Decimal(12, 3) @default(0)
  lowStockThreshold Int @default(5)

  @@unique([storeId, productId])
  @@index([productId])
}

model Sale {
  id          String        @id @default(cuid())
  saleNumber  String        @unique
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  items       SaleItem[]
  total       Decimal       @db.Decimal(12, 2)
  subtotal    Decimal       @db.Decimal(12, 2)
  discount    Decimal       @db.Decimal(12, 2) @default(0)
  profit      Decimal       @db.Decimal(12, 2)
  profitMargin Decimal      @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status      String        @default("COMPLETED")
  canceledAt  DateTime?
  canceledBy  String?
  cancellationReason  CancellationReason?
  cancellationComment String?
  createdAt   DateTime      @default(now())

  factura Factura?

  @@index([storeId, createdAt])
  @@index([saleNumber])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  // Decimal para ventas a granel (ej. 0.25 kg). Para UNIDAD es entero.
  quantity    Decimal  @db.Decimal(12, 3)
  // Snapshot de la unidad de venta al momento de la venta ("u", "kg", "L").
  unidad      String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  costPrice   Decimal  @db.Decimal(12, 2)
  profit      Decimal  @db.Decimal(12, 2)
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions SupplierTransaction[]

  @@index([storeId])
}

model SupplierTransaction {
  id            String                       @id @default(cuid())
  supplierId    String
  supplier      Supplier                     @relation(fields: [supplierId], references: [id])
  storeId       String
  store         Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId        String
  user          User                         @relation(fields: [userId], references: [id])
  items         SupplierTransactionItem[]
  paymentMethod PaymentMethod
  total         Decimal                      @db.Decimal(12, 2)
  status        String                       @default("COMPLETED")
  canceledAt    DateTime?
  canceledBy    String?
  cancellationReason  CancellationReason?
  cancellationComment String?
  createdAt     DateTime                     @default(now())

  @@index([storeId, createdAt])
}

model SupplierTransactionItem {
  id          String               @id @default(cuid())
  transactionId String
  transaction SupplierTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product              @relation(fields: [productId], references: [id])
  // Decimal para compras a granel (ej. 25.5 kg).
  quantity    Decimal              @db.Decimal(12, 3)
  unitCost    Decimal              @db.Decimal(12, 2)
}

model AuditLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([entity, entityId])
}

model Cliente {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rfc              String
  nombreRazonSocial String
  representanteLegal String?
  codigoPostal     String
  regimenFiscal    String
  usoCfdi          String?
  email            String?
  phone            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  facturas Factura[]

  @@unique([storeId, rfc])
  @@index([storeId, nombreRazonSocial])
}

model Factura {
  id        String   @id @default(cuid())
  folio     String   @unique
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleId    String   @unique
  sale      Sale     @relation(fields: [saleId], references: [id])
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  emisorRfc             String
  emisorNombre          String
  emisorRegimenFiscal   String
  emisorCodigoPostal    String
  receptorRfc           String
  receptorNombre        String
  receptorCodigoPostal  String
  receptorRegimenFiscal String
  usoCfdi               String

  subtotal Decimal @db.Decimal(12, 2)
  descuento Decimal @db.Decimal(12, 2) @default(0)
  total    Decimal @db.Decimal(12, 2)
  moneda   String  @default("MXN")
  status   String  @default("EMITIDA")
  canceledAt DateTime?
  canceledBy String?
  cancellationReason  CancellationReason?
  cancellationComment String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([clienteId])
}

model Cancellation {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: SetNull)

  entityType    String
  entityId      String
  entityNumber  String
  total         Decimal  @db.Decimal(12, 2)

  reason        CancellationReason
  comment       String?

  createdAt     DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([entityType, entityId])
}