generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GERENTE
  VENDEDOR
  SOPORTE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
  OTHER
}

enum StoreRelation {
  OWNED
  ASSIGNED
}

// Forma de venta del producto:
// - UNIDAD: se vende por bulto/pieza (cantidad entera).
// - PESO: se vende a granel por peso; costPrice/sellingPrice son por kilogramo.
// - VOLUMEN: se vende a granel por volumen; costPrice/sellingPrice son por litro.
enum UnidadVenta {
  UNIDAD
  PESO
  VOLUMEN
}

enum PromotionType {
  DIRECT_AMOUNT
  PERCENTAGE
  N_FOR_DISCOUNT
  N_FOR_FREE
  TIERED_BY_AMOUNT
  COMBO
  CATEGORY_PERCENTAGE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TicketStatus {
  OPEN
  ANALYSIS
  REVIEW
  CORRECTION
  SOLVED
  CLOSED
  REJECTED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketModule {
  INVENTORY
  SALES
  INVOICES
  CASHREGISTERS
  PRODUCTS
  ORDERS
  PROMOTIONS
  USERS
  STORES
  REPORTS
  CANCELLATIONS
}

// Motivo editable de cancelación (venta, factura, compra a proveedor).
// La lista es por tienda y se administra desde el módulo de cancelaciones.
model CancellationReason {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cancellations      Cancellation[]
  sales              Sale[]
  facturas           Factura[]
  supplierTxs        SupplierTransaction[]

  @@unique([storeId, name])
  @@index([storeId])
}

// Tipo de movimiento de inventario manual:
// - ENTRADA: suma stock (ajuste positivo, devolución, reabasto manual).
// - SALIDA: resta stock (merma, producto echado a perder, pérdida, venta no registrada).
enum MovementTipo {
  ENTRADA
  SALIDA
}

model Store {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  representante String?
  phone     String?
  rfc           String?
  regimenFiscal String?
  codigoPostal  String?
  saleSequence Int    @default(0)
  facturaSequence Int @default(0)
  purchaseSequence Int @default(0)
  ticketSequence Int @default(0)
  notifyOutOfStock Boolean @default(true)
  notifyLowStock   Boolean @default(true)
  controlCajas Boolean @default(false)
  aperturaCajaConInventario Boolean @default(true)
  autoCloseEnabled Boolean   @default(false)
  autoCloseTime    String?
  autoCloseDays    String[]  @default(["1","2","3","4","5","6"])
  umbralAlertaEfectivo   Decimal? @db.Decimal(12, 2)
  umbralAlertaTarjeta    Decimal? @db.Decimal(12, 2)
  umbralAlertaEgresos    Decimal? @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userStores        UserStore[]
  inventories    Inventory[]
  sales          Sale[]
  supplierTx     SupplierTransaction[]
  products       Product[]
  auditLogs      AuditLog[]
  categories     Category[]
  suppliers      Supplier[]
  clientes       Cliente[]
  facturas       Factura[]
  cancellations  Cancellation[]
  cancellationReasons CancellationReason[]
  movementReasons MovementReason[]
  stockMovements  StockMovement[]
  inventorySnapshots InventorySnapshot[]
  cajas           Caja[]
  cajaSessions    CajaSession[]
  cajaMovimientos CajaMovimiento[]
  cajaMovimientoMotivos CajaMovimientoMotivo[]
  cajaAlerts      CajaAlert[]
  promotions      Promotion[]
  promotionApplications PromotionApplication[]
  tickets         Ticket[]
  ticketConfigs   TicketConfig[]
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  password     String
  name         String
  role         Role           @default(VENDEDOR)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  userStores       UserStore[]
  sales            Sale[]
  supplierTx       SupplierTransaction[]
  auditLogs        AuditLog[]
  revokedTokens    RevokedToken[]
  facturas         Factura[]
  cancellations    Cancellation[]
  stockMovements   StockMovement[]
  cajasAsignadas   Caja[]            @relation("CajaUser")
  cajaSessions     CajaSession[]
  cajaMovimientos  CajaMovimiento[]
  createdPromotions Promotion[]
  tickets         Ticket[]
  ticketComments  TicketComment[]
  assignedTickets Ticket[] @relation("TicketAssignedSoporte")
}

// Relación muchos a muchos Usuario↔Tienda: un usuario puede administrar
// varias tiendas; cada membresía tiene su propio rol y opcionalmente marca
// la tienda primaria (la que se autoselecciona tras el login).
model UserStore {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  role      Role     @default(VENDEDOR)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId, isPrimary])
}

model RevokedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  products Product[]
  promotionItems PromotionItem[]
  @@unique([name, storeId])
}

model Product {
  id           String     @id @default(uuid())
  name         String
  sku          String?    @unique
  description  String?
  presentacion String?
  unidadVenta  UnidadVenta @default(UNIDAD)
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  costPrice    Decimal    @db.Decimal(12, 2)
  sellingPrice Decimal    @db.Decimal(12, 2)
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  expirationDate DateTime? @default("2100-02-02T00:00:00Z")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inventories          Inventory[]
  saleItems            SaleItem[]
  supplierTxItems      SupplierTransactionItem[]
  stockMovements       StockMovement[]
  promotionItems       PromotionItem[]
  promotionApplications PromotionApplication[]

  @@index([storeId])
  @@index([categoryId])
}

model Inventory {
  id        String  @id @default(uuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Decimal para soportar productos a granel (ej. 25.5 kg de arroz).
  quantity  Decimal @db.Decimal(12, 3) @default(0)
  lowStockThreshold Int @default(5)

  @@unique([storeId, productId])
  @@index([productId])
}

// Motivo editable de un movimiento de inventario (merma, caducado, robo, reabasto, etc.).
// La lista es por tienda y se administra desde el módulo de inventario.
model MovementReason {
  id           String        @id @default(uuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  tipo         MovementTipo
  departamento String?       // abarrotes, cremería, etc. (opcional, para agrupar)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  movements    StockMovement[]

  @@unique([storeId, name])
  @@index([storeId])
}

// Bitácora de movimientos manuales de inventario. Cada fila ajusta Inventory.quantity
// de forma atómica y guarda el saldo antes/después para trazabilidad.
model StockMovement {
  id                  String         @id @default(uuid())
  storeId             String
  store               Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId           String
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  reasonId            String
  reason              MovementReason @relation(fields: [reasonId], references: [id])
  tipo                MovementTipo
  quantity            Decimal        @db.Decimal(12, 3)
  balanceBefore       Decimal        @db.Decimal(12, 3)
  balanceAfter        Decimal        @db.Decimal(12, 3)
  unitCost            Decimal        @db.Decimal(12, 2)  // costo del producto al momento del movimiento
  // Agrupa movimientos creados en un solo registro (lote multi-producto).
  batchId             String?
  // Vincula el movimiento con la entidad de negocio que lo originó
  // (ej. "SUPPLIER_TX" para compras a proveedor) y su id.
  referenceType       String?
  referenceId         String?
  // Pérdida valorizada (cantidad * unitCost) solo para SALIDAS; null en ENTRADAS.
  lossValue           Decimal?       @db.Decimal(12, 2)
  comment             String?
  status              String         @default("ACTIVE")   // ACTIVE | CANCELLED
  cancelledAt         DateTime?
  cancelledBy         String?
  cancellationReason  String?
  cancellationComment String?
  createdAt           DateTime       @default(now())

  @@index([storeId, createdAt])
  @@index([productId])
  @@index([reasonId])
  @@index([batchId])
  @@index([referenceType, referenceId])
  @@index([userId])
}

// Snapshot de apertura del día: captura el stock al iniciar operaciones.
// Si existe para la fecha, el reporte usa este valor como "inventario inicial";
// de lo contrario se reconstruye a partir de ventas/compras/movimientos del día.
model InventorySnapshot {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  date      DateTime
  quantity  Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now())

  @@unique([storeId, productId, date])
  @@index([storeId, date])
}

model Sale {
  id          String        @id @default(uuid())
  saleNumber  String        @unique
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  items       SaleItem[]
  total       Decimal       @db.Decimal(12, 2)
  subtotal    Decimal       @db.Decimal(12, 2)
  discount    Decimal       @db.Decimal(12, 2) @default(0)
  profit      Decimal       @db.Decimal(12, 2)
  profitMargin Decimal      @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  // COMPLETED (venta confirmada), PENDING (pedido sin confirmar, no descuenta
  // inventario), CANCELED (venta o pedido anulado).
  status      String        @default("COMPLETED")
  // Pedido: cliente asociado (opcional) y notas libres.
  clienteId   String?
  cliente     Cliente?      @relation(fields: [clienteId], references: [id])
  notes       String?
  // Sesión de caja que procesó la venta (corte de caja).
  cajaSessionId String?
  cajaSession  CajaSession? @relation(fields: [cajaSessionId], references: [id], onDelete: SetNull)
  // Quién y cuándo confirmó el pedido (status PENDING -> COMPLETED).
  confirmedAt DateTime?
  confirmedBy String?
  canceledAt  DateTime?
  canceledBy  String?
  cancellationReasonId  String?
  cancellationReason    CancellationReason? @relation(fields: [cancellationReasonId], references: [id])
  cancellationComment String?
  createdAt   DateTime      @default(now())

  factura Factura?
  promotionApplications PromotionApplication[]

  @@index([storeId, createdAt])
  @@index([saleNumber])
  @@index([status])
  @@index([clienteId])
  @@index([userId])
  @@index([cajaSessionId])
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  // Decimal para ventas a granel (ej. 0.25 kg). Para UNIDAD es entero.
  quantity    Decimal  @db.Decimal(12, 3)
  // Snapshot de la unidad de venta al momento de la venta ("u", "kg", "L").
  unidad      String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  // Precio normal (sin promo) para mostrar en ticket como tachado.
  originalUnitPrice Decimal? @db.Decimal(12, 2)
  costPrice   Decimal  @db.Decimal(12, 2)
  profit      Decimal  @db.Decimal(12, 2)

  canceledAt       DateTime?
  canceledBy       String?
  cancellationId   String?
  cancellation     Cancellation? @relation(fields: [cancellationId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  rfc         String?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  postalCode  String?
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions SupplierTransaction[]

  @@index([storeId])
}

model SupplierTransaction {
  id            String                       @id @default(uuid())
  supplierId    String
  supplier      Supplier                     @relation(fields: [supplierId], references: [id])
  storeId       String
  store         Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId        String
  user          User                         @relation(fields: [userId], references: [id])
  items         SupplierTransactionItem[]
  paymentMethod PaymentMethod
  // Folio legible para la "Nota de compra" (ej. COMPRA-STORE001-0001).
  reference     String                       @unique
  total         Decimal                      @db.Decimal(12, 2)
  status        String                       @default("COMPLETED")
  // Origen del pago: "CAJA" (dinero del tPV, descuenta del corte) o "DUENO"
  // (efectivo del dueño, se registra sin afectar el corte de caja).
  paidFrom     String                       @default("DUENO")
  // Sesión de caja que procesó la compra (solo cuando paidFrom = "CAJA").
  cajaSessionId String?
  cajaSession  CajaSession? @relation(fields: [cajaSessionId], references: [id], onDelete: SetNull)
  canceledAt    DateTime?
  canceledBy    String?
  cancellationReasonId  String?
  cancellationReason    CancellationReason? @relation(fields: [cancellationReasonId], references: [id])
  cancellationComment String?
  createdAt     DateTime                     @default(now())

  @@index([storeId, createdAt])
  @@index([supplierId])
  @@index([userId])
  @@index([cajaSessionId])
  @@index([paidFrom])
}

model SupplierTransactionItem {
  id          String               @id @default(uuid())
  transactionId String
  transaction SupplierTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product              @relation(fields: [productId], references: [id])
  // Decimal para compras a granel (ej. 25.5 kg).
  quantity    Decimal              @db.Decimal(12, 3)
  unitCost    Decimal              @db.Decimal(12, 2)
  // Margen de ganancia aplicado sobre el costo para sugerir el precio de
  // venta (por defecto 16%). Si se define `sellingPrice`, prevalece.
  marginPct   Decimal              @db.Decimal(5, 2) @default(16)
  // Precio de venta resultante (sugerido o sobrescrito por el usuario).
  sellingPrice Decimal?            @db.Decimal(12, 2)

  @@index([transactionId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

model Cliente {
  id               String   @id @default(uuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rfc              String
  nombreRazonSocial String
  representanteLegal String?
  codigoPostal     String
  regimenFiscal    String
  usoCfdi          String?
  email            String?
  phone            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  facturas Factura[]

  sales    Sale[]

  @@unique([storeId, rfc])
  @@index([storeId, nombreRazonSocial])
}

model Factura {
  id        String   @id @default(uuid())
  folio     String   @unique
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleId    String   @unique
  sale      Sale     @relation(fields: [saleId], references: [id])
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  emisorRfc             String
  emisorNombre          String
  emisorRegimenFiscal   String
  emisorCodigoPostal    String
  receptorRfc           String
  receptorNombre        String
  receptorCodigoPostal  String
  receptorRegimenFiscal String
  usoCfdi               String

  subtotal Decimal @db.Decimal(12, 2)
  descuento Decimal @db.Decimal(12, 2) @default(0)
  total    Decimal @db.Decimal(12, 2)
  moneda   String  @default("MXN")
  status   String  @default("EMITIDA")
  canceledAt DateTime?
  canceledBy String?
  cancellationReasonId  String?
  cancellationReason    CancellationReason? @relation(fields: [cancellationReasonId], references: [id])
  cancellationComment String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([clienteId])
  @@index([userId])
}

model Cancellation {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  entityType    String
  entityId      String
  entityNumber  String
  total         Decimal  @db.Decimal(12, 2)
  type          String   @default("FULL") // FULL | PARTIAL

  cancellationReasonId  String?
  cancellationReason    CancellationReason? @relation(fields: [cancellationReasonId], references: [id])

  saleItems     SaleItem[]
  items         CancellationItem[]

  comment       String?

  createdAt     DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([entityType, entityId])
  @@index([cancellationReasonId])
  @@index([userId])
}

// Artículos cancelados dentro de una cancelación (usado en cancelaciones parciales).
model CancellationItem {
  id              String   @id @default(uuid())
  cancellationId  String
  cancellation    Cancellation @relation(fields: [cancellationId], references: [id], onDelete: Cascade)
  storeId         String
  saleItemId      String
  productId       String
  productName     String
  quantity        Decimal  @db.Decimal(12, 3)
  unidad          String?
  unitPrice       Decimal  @db.Decimal(12, 2)
  costPrice       Decimal  @db.Decimal(12, 2)
  profit          Decimal  @db.Decimal(12, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@index([cancellationId])
  @@index([storeId])
  @@index([productId])
  @@index([saleItemId])
}

// Caja física de la tienda. El admin/gerente las da de alta y opcionalmente
// las asigna a un vendedor para que inicie sesión "con su caja" desde cualquier
// equipo. Una misma caja no puede tener dos sesiones abiertas a la vez.
model Caja {
  id             String   @id @default(uuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  assignedUserId String?
  assignedUser   User?    @relation("CajaUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions       CajaSession[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([assignedUserId])
}

// Turno de caja: combina la apertura (saldo inicial declarado) y el cierre
// (saldo declarado + resultados calculados). Si la tienda usa control de cajas
// con inventario, al abrir se captura el InventorySnapshot del día.
model CajaSession {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cajaId    String
  caja      Caja     @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  userId    String   // operador que abrió la caja
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("OPEN") // OPEN | CLOSED

  // Apertura
  openedAt           DateTime @default(now())
  openingDate        String?  // fecha local MExico (yyyy-mm-dd) para filtrar por día
  openingCash        Decimal  @db.Decimal(12, 2) @default(0)
  openingElectronic  Decimal  @db.Decimal(12, 2) @default(0)
  openingNote        String?
  inventoryAdjusted  Boolean?

  // Cierre (declarado por el operador)
  closedAt           DateTime?
  closingDate        String? // fecha local Mexico (yyyy-mm-dd) del cierre
  closedBy           String?
  closingCash        Decimal? @db.Decimal(12, 2) // LEGACY: usar closingAmounts
  closingElectronic  Decimal? @db.Decimal(12, 2) // LEGACY: usar closingAmounts
  closingNote        String?
  closingAmounts     Json?    // { CASH, CARD, TRANSFER, CREDIT, OTHER }
  expectedAmounts    Json?    // { CASH, CARD, TRANSFER, CREDIT, OTHER }
  diffByMethod       Json?    // { CASH, CARD, TRANSFER, CREDIT, OTHER }

  // Resultados calculados al cierre (LEGACY: usar closingAmounts/expectedAmounts)
  salesCash           Decimal? @db.Decimal(12, 2)
  salesElectronic     Decimal? @db.Decimal(12, 2)
  purchasesCash       Decimal? @db.Decimal(12, 2)
  purchasesElectronic Decimal? @db.Decimal(12, 2)
  expectedCash        Decimal? @db.Decimal(12, 2)
  expectedElectronic  Decimal? @db.Decimal(12, 2)
  diffCash            Decimal? @db.Decimal(12, 2)
  diffElectronic      Decimal? @db.Decimal(12, 2)

  // Reapertura (solo ADMIN/GERENTE, con motivo; el evento queda en AuditLog)
  reopenedAt   DateTime?
  reopenedBy   String?
  reopenReason String?

  sales        Sale[]
  supplierTxs  SupplierTransaction[]
  movimientos  CajaMovimiento[]
  alerts       CajaAlert[]

  @@index([storeId, status])
  @@index([storeId, openingDate])
  @@index([cajaId])
  @@index([userId])
}

// Movimiento de dinero registrado sobre una sesión abierta de caja: ingreso
// (feria, fondo) o egreso (retiro de margen). Afecta el corte esperado de la
// sesión según su método (efectivo o electrónico).
model CajaMovimiento {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cajaSessionId String
  session       CajaSession @relation(fields: [cajaSessionId], references: [id], onDelete: Cascade)
  userId        String // quien registró el movimiento
  user          User     @relation(fields: [userId], references: [id])
  tipo          String // INGRESO | EGRESO
  metodo        String   @default("CASH") // CASH | ELECTRONIC
  monto         Decimal  @db.Decimal(12, 2)
  motivoId      String?
  motivo        CajaMovimientoMotivo? @relation(fields: [motivoId], references: [id])
  motivoTexto   String?  // Texto libre cuando se selecciona "Otro"
  createdAt     DateTime @default(now())

  @@index([storeId])
  @@index([cajaSessionId])
  @@index([userId])
}

// Catálogo de motivos para movimientos de caja.
// INGRESO = inyección de dinero (fondo, cambio, devolución).
// EGRESO = retiro de dinero (feria, gasto, pago proveedor).
model CajaMovimientoMotivo {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tipo      String   // INGRESO | EGRESO
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  movimientos CajaMovimiento[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([tipo])
}

// Registro histórico de alertas de umbral en caja.
// Se crea cuando un egreso cruza el umbral configurado para la tienda.
model CajaAlert {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cajaSessionId String
  session       CajaSession @relation(fields: [cajaSessionId], references: [id], onDelete: Cascade)
  tipo          String   // INGRESO | EGRESO
  metodo        String   // CASH | ELECTRONIC
  monto         Decimal  @db.Decimal(12, 2)
  saldoDisponible Decimal @db.Decimal(12, 2)
  umbral        Decimal  @db.Decimal(12, 2)
  sobrepaso     Decimal  @db.Decimal(12, 2)
  triggeredAt   DateTime @default(now())

  @@index([storeId])
  @@index([cajaSessionId])
  @@index([triggeredAt])
}

// Promociones aplicables a productos o categorías dentro de una tienda.
// Cada Promotion tiene una configuración polimórfica en `config` (JSON) según
// su `type` (ver PromotionType). Los productos/categorías afectados se
// registran en `PromotionItem`.
model Promotion {
  id          String        @id @default(uuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        PromotionType
  // Configuración específica por tipo (ver `promotionCalculator.ts`).
  config      Json
  // Vigencia obligatoria.
  startsAt    DateTime
  endsAt      DateTime
  // Restricción horaria opcional (null = cualquier día/hora).
  weekdays    Weekday[]
  timeFrom    String?
  timeTo      String?
  // Control de uso y prioridad para resolver conflictos entre promos.
  isActive    Boolean       @default(true)
  priority    Int           @default(0)
  maxUses     Int?
  usesCount   Int           @default(0)
  // Auditoría.
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items       PromotionItem[]
  applications PromotionApplication[]

  @@index([storeId, isActive])
  @@index([storeId, startsAt, endsAt])
  @@index([type])
}

model PromotionItem {
  id          String     @id @default(uuid())
  promotionId String
  promotion   Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // CATEGORY_PERCENTAGE: categoría afectada (alternativa a productId).
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // COMBO: precio fijo del pack completo (null = el config define descuento %).
  comboPrice  Decimal?   @db.Decimal(12, 2)

  @@unique([promotionId, productId])
  @@unique([promotionId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

// Bitácora de cada aplicación de promoción en una venta. Permite reportes
// (veces aplicada, $ descontado, impacto en margen) y reversión al cancelar.
model PromotionApplication {
  id               String    @id @default(uuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  promotionId      String
  promotion        Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  saleId           String
  sale             Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Línea o pack al que se aplicó. null para TIERED_BY_AMOUNT (afecta venta).
  productId        String?
  product          Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Impacto monetario.
  originalAmount   Decimal   @db.Decimal(12, 2)
  discountedAmount Decimal   @db.Decimal(12, 2)
  savedAmount      Decimal   @db.Decimal(12, 2)
  // Detalles del cálculo (ej. "se aplicó 2 veces en unidades 1, 2 de 3").
  details          Json?
  createdAt        DateTime  @default(now())

  @@index([storeId, createdAt])
  @@index([saleId])
  @@index([promotionId])
  @@index([productId])
}

// Ticket de soporte técnico. El folio es STORE-CODE + secuencial (TICKET-STORE001-0001).
model Ticket {
  id        String       @id @default(uuid())
  folio     String       @unique
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  // Usuario de soporte asignado (null = sin asignar).
  assignedToSoporteId String?
  assignedToSoporte   User?    @relation("TicketAssignedSoporte", fields: [assignedToSoporteId], references: [id], onDelete: SetNull)

  ticketModule TicketModule
  subject      String
  description  String      @db.VarChar(255)
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  solutionEvidence         String?   @db.Text  // base64 encoded file
  solutionEvidenceFileName String?
  solutionEvidenceMimeType String?
  solutionComment         String?

  rating          Int?
  ratingComment   String?

  rejectReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    TicketComment[]
  attachments TicketAttachment[]

  @@index([storeId])
  @@index([userId])
  @@index([assignedToSoporteId])
  @@index([status])
  @@index([ticketModule])
  @@index([priority])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
}

model TicketAttachment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  data      String   @db.Text  // base64 encoded
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Configuración de soporte por tienda: qué usuario SOPORTE atiende la tienda.
model TicketConfig {
  storeId      String   @id
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  soporteUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}